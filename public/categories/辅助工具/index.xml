&lt;/blockquote&gt;
&lt;h2 id=&#34;字体&#34;&gt;字体&lt;/h2&gt;
&lt;table&gt;
  &lt;thead&gt;
      &lt;tr&gt;
          &lt;th&gt;代码&lt;/th&gt;
          &lt;th&gt;效果&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;code&gt;*这是斜体*&lt;/code&gt;&lt;/td&gt;
          &lt;td&gt;&lt;em&gt;这是斜体&lt;/em&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;code&gt;_这是斜体_&lt;/code&gt;&lt;/td&gt;
          &lt;td&gt;&lt;em&gt;这是斜体&lt;/em&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;code&gt;**这是粗体**&lt;/code&gt;&lt;/td&gt;
          &lt;td&gt;&lt;strong&gt;这是粗体&lt;/strong&gt;&lt;/td&gt;
      &lt;/tr&gt;
      &lt;tr&gt;
          &lt;td&gt;&lt;code&gt;__这是粗体__&lt;/code&gt;&lt;/td&gt;
