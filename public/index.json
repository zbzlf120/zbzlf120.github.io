[{"content":" Mybatis常用Mapper语句 插入 /*简单插入*/ \u0026lt;insert id=\u0026#34;insertOne\u0026#34; parameterType=\u0026#34;Person\u0026#34;\u0026gt; insert into person (id, name, age) values(#{id},#{name},#{age}); \u0026lt;/insert\u0026gt; /* 插入并返回对象的主键（数据库序列） */ \u0026lt;insert id=\u0026#34;insertOne\u0026#34; parameterType=\u0026#34;Person\u0026#34; useGeneratedKeys=\u0026#34;true\u0026#34; keyProperty=\u0026#34;id\u0026#34;\u0026gt; insert into person (name, age) VALUES(#{name}, #{age}); \u0026lt;/insert\u0026gt; 更新 /* 简单更新 */ \u0026lt;update id=\u0026#34;updateName\u0026#34;\u0026gt; update person set name = #{name} where id = #{id}; \u0026lt;/update\u0026gt; /* 更新值并返回 */ \u0026lt;select id=\u0026#34;updateAge\u0026#34; parameterType=\u0026#34;Person\u0026#34;\u0026gt; update person set age = age + #{age} where id = #{id} returning age; \u0026lt;/select\u0026gt; 插入或更新 方式一 \u0026lt;insert id=\u0026#34;addCount\u0026#34; parameterType=\u0026#34;CountRecord\u0026#34;\u0026gt; /*如果有记录，则更新；无记录，则noting*/ update count_record set \u0026#34;count\u0026#34; = \u0026#34;count\u0026#34;+1 where type_id = #{typeId} and user_id = #{userId}; /*如果有记录，则noting；无记录，则插入*/ insert into count_record(type_id, user_id, \u0026#34;count\u0026#34;) select #{typeId}, #{userId}, 1 where not exists (select * from count where type_id = #{typeId} and user_id = #{userId}); \u0026lt;/insert\u0026gt; 方式2 /* 利用 PostgreSQL 的 conflic 特性 */ \u0026lt;insert id=\u0026#34;addCount\u0026#34; parameterType=\u0026#34;CountRecord\u0026#34;\u0026gt; insert into count_record(type_id, user_id, \u0026#34;count\u0026#34;) VALUES (#{typeId}, #{userId}, #{count}) on conflict(type_id,user_id) do update set \u0026#34;count\u0026#34; = count_record.\u0026#34;count\u0026#34; + 1 \u0026lt;/insert\u0026gt; ","permalink":"http://localhost:1313/posts/mybatis01/","summary":"\u003c!-- raw HTML omitted --\u003e\n\u003ch3 id=\"mybatis常用mapper语句\"\u003eMybatis常用Mapper语句\u003c/h3\u003e\n\u003ch4 id=\"插入\"\u003e插入\u003c/h4\u003e\n\u003